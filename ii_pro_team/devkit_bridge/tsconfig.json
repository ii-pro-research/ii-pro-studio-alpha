{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "esModuleInterop": true, "verbatimModuleSyntax": true,
    "rootDir": "vendor/local/src", "outDir": "vendor/local/dist"
  },
  "include": ["vendor/local/src/*.ts"]
}
